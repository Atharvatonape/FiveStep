# Copy this file to `.env` and fill in your values, then run ./scripts/up.sh
#
#   cp .env.example .env
#   # edit .env
#   ./scripts/up.sh

# The AWS CLI profile to use (must point at YOUR account).
# Create one with:  aws configure --profile my-profile
AWS_PROFILE=my-profile

# AWS region to deploy into.
AWS_REGION=us-east-1

# A globally-unique name for your Terraform state S3 bucket.
# S3 bucket names are unique across ALL of AWS, so pick something unique —
# e.g. include your name or a random suffix.
TF_STATE_BUCKET=fivestep-tfstate-CHANGE-ME

# Image tag to build/deploy. Bump this when you change the app.
IMAGE_TAG=v1
